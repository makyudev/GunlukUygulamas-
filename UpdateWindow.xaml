<Window x:Class="GunlukUygulamasi.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Güncelleme"
        Icon="app.ico"
        Width="560"
        Height="590"
        MinHeight="460"
        MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Margin="18" Padding="28"
            Background="{DynamicResource BgSidebarBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="WindowHeadingText"
                       FontSize="21" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="VersionText"
                       Grid.Row="1" Margin="0,8,0,16"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />

            <Border Grid.Row="2" Padding="16"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Güncelleme Notları" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock x:Name="ReleaseNotesText"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="InstallerStatusText"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" />
                <ProgressBar x:Name="DownloadProgressBar" Height="7" Margin="0,8,0,0"
                             Minimum="0" Maximum="100" Visibility="Collapsed" />
                <TextBlock x:Name="DownloadStatusText" Margin="0,6,0,0"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,20,0,0"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Style="{StaticResource SecondaryButtonStyle}"
                        Content="Daha Sonra" Click="LaterButton_Click" Margin="0,0,8,0" />
                <Button x:Name="InstallButton" Style="{StaticResource PrimaryButtonStyle}"
                        Content="Şimdi İndir ve Güncelle" Click="InstallButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
