<UserControl x:Class="GunlukUygulamasi.Controls.PixelAquariumControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="120" MinHeight="120" UseLayoutRounding="True">
    <Border BorderBrush="{DynamicResource BorderFocusBrush}" BorderThickness="1" CornerRadius="12"
            Background="Transparent">
        <Grid ClipToBounds="True">
            <Border Background="{DynamicResource BgPrimaryBrush}" CornerRadius="12" Opacity="0.88" />
            <Canvas x:Name="AquariumCanvas" Background="Transparent" ClipToBounds="True"
                    MouseLeftButtonDown="AquariumCanvas_MouseLeftButtonDown"
                    SizeChanged="AquariumCanvas_SizeChanged" />
            <StackPanel Panel.ZIndex="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="8,6,8,0">
                <TextBlock x:Name="FishInfoText" Text="Maviş · 0 yem" FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.68"
                           Cursor="Hand" MouseLeftButtonDown="FishInfoText_MouseLeftButtonDown" />
                <TextBox x:Name="FishNameEditor" Width="86" Height="20" MaxLength="16"
                         Padding="4,0" FontSize="10" Visibility="Collapsed"
                         Background="{DynamicResource BgSurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                         KeyDown="FishNameEditor_KeyDown" LostFocus="FishNameEditor_LostFocus" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
