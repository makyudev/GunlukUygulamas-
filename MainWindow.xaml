                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,14"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="AuthenticationTitleText" Text="Günlüğünüz güvende" FontSize="22"
                               FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="AuthenticationSubtitleText" Text="Devam etmek için PIN veya parolanızı girin."
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,22" />
                    <Border x:Name="AuthenticationPasswordBorder" CornerRadius="10"
                            Background="{DynamicResource BgSurfaceBrush}" BorderThickness="1" Margin="0,0,0,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="0"
                                                                  Color="{DynamicResource AccentColor}" Opacity="0.24" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
