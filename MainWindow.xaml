                                     Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource AccentHoverBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Padding="14,11,48,11"
                                     FontSize="15" MaxLength="256"
                                     TextChanged="AuthenticationVisiblePasswordTextBox_TextChanged"
                                     PreviewKeyDown="AuthenticationInput_PreviewKeyDown"
                                     PreviewKeyUp="AuthenticationInput_PreviewKeyUp"
                                     GotKeyboardFocus="AuthenticationInput_GotKeyboardFocus"
                                     LostKeyboardFocus="AuthenticationInput_LostKeyboardFocus" />
