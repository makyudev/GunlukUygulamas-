                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Klavye Kısayolları" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18" />
                    <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Margin" Value="0,3,12,3" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="Yazım ve düzenleme" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentHoverBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <TextBlock Text="Ctrl+Z  —  Geri Al" />
                                <TextBlock Text="Ctrl+Y / Ctrl+Shift+Z  —  İleri Al" />
                                <TextBlock Text="Ctrl+D  —  Tarih ve saati ekle" />
                                <TextBlock Text="Ctrl+L  —  Madde işareti ekle" />
                            </UniformGrid>
                            <TextBlock Text="Günlük ve gezinme" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentHoverBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <TextBlock Text="Ctrl+N  —  Yeni günlük" />
                                <TextBlock Text="Ctrl+S  —  Kaydet" />
                                <TextBlock Text="Ctrl+F  —  Aramaya odaklan" />
                                <TextBlock Text="Ctrl+P  —  Sabitle / kaldır" />
                                <TextBlock Text="Ctrl+E  —  Dışa aktar" />
                                <TextBlock Text="Ctrl+,  —  Ayarlar" />
                                <TextBlock Text="Ctrl+B  —  Kenar çubuğunu aç / kapat" />
                                <TextBlock Text="Ctrl+K  —  Uygulamayı kilitle" />
                                <TextBlock Text="Delete  —  Seçili günlüğü sil*" />
                                <TextBlock Text="Esc  —  Açık pencereyi kapat" />
                            </UniformGrid>
                            <TextBlock Text="Görünüm ve yardım" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentHoverBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2">
                                <TextBlock Text="Ctrl++  —  Yazıyı büyüt" />
                                <TextBlock Text="Ctrl+-  —  Yazıyı küçült" />
                                <TextBlock Text="F1  —  Bu pencereyi aç" />
                            </UniformGrid>
                            <TextBlock Text="* Günlük listesinden seçiliyken. Ctrl+C / V / X / A: kopyala, yapıştır, kes ve tümünü seç."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,16,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="CancelModalButton_Click"
                            Content="Kapat" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="96" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="AuthenticationOverlayGrid" Panel.ZIndex="20"
              Visibility="Collapsed" Opacity="0">
