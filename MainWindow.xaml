                                    ToolTip="Ayarları kaydet">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5,3H17L21,7V21H3V3Z M7,3V9H16V3 M7,21V13H17V21"
                                          Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
