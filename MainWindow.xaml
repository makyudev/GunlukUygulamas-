                                     GotKeyboardFocus="AuthenticationInput_GotKeyboardFocus" />
                        <TextBox x:Name="AuthenticationVisiblePasswordTextBox"
                                 Style="{StaticResource DarkTextBoxStyle}" Visibility="Collapsed"
                                 Foreground="{StaticResource TextPrimaryBrush}" Padding="14,11,48,11"
                                 FontSize="15" MaxLength="256"
                                 TextChanged="AuthenticationVisiblePasswordTextBox_TextChanged"
                                 PreviewKeyDown="AuthenticationInput_PreviewKeyDown"
                                 PreviewKeyUp="AuthenticationInput_PreviewKeyUp"
                                 GotKeyboardFocus="AuthenticationInput_GotKeyboardFocus" />
                        <Button x:Name="AuthenticationPasswordVisibilityButton" Width="38" Height="34"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                Background="Transparent" BorderThickness="0" Padding="8"
                                Click="AuthenticationPasswordVisibilityButton_Click"
                                Focusable="False" ToolTip="Şifreyi göster veya gizle">
                            <Path x:Name="AuthenticationEyePath"
                                  Data="M12,5C7,5 2.73,8.11 1,12C2.73,15.89 7,19 12,19C17,19 21.27,15.89 23,12C21.27,8.11 17,5 12,5M12,16.5A4.5,4.5 0 1,1 12,7.5A4.5,4.5 0 0,1 12,16.5M12,14A2,2 0 1,0 12,10A2,2 0 0,0 12,14"
                                  Fill="Transparent" Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="AuthenticationCapsLockText" Text="Caps Lock Açık" FontSize="11"
                               Foreground="#FBBF24" Margin="2,0,0,6" Visibility="Collapsed" />
                    <TextBlock x:Name="AuthenticationHintText" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                               Margin="2,0,0,12" Visibility="Collapsed" />
                    <PasswordBox x:Name="AuthenticationConfirmationBox" Background="{StaticResource BgSurfaceBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}" Padding="14,11"
                                 FontSize="15" Margin="0,0,0,12" Visibility="Collapsed" />
                    <TextBlock x:Name="AuthenticationErrorText" Foreground="#FCA5A5" FontSize="12"
                               TextWrapping="Wrap" Margin="2,0,0,12" />
                    <Button x:Name="AuthenticationActionButton" Style="{StaticResource PrimaryButtonStyle}"
                            Click="AuthenticationActionButton_Click" Content="Kilidi Aç" IsDefault="True" />
                    <Button x:Name="SkipPasswordSetupButton" Style="{StaticResource SecondaryButtonStyle}"
                            Click="SkipPasswordSetupButton_Click" Content="PIN kullanmadan devam et"
                            Margin="0,10,0,0" Visibility="Collapsed" />
                    <Button Style="{StaticResource GhostIconButtonStyle}" Click="ExitAuthenticationButton_Click"
                            Content="Uygulamadan çık" Width="Auto" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

