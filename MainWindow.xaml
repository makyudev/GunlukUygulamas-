<Window x:Class="GunlukUygulamasi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GunlukUygulamasi"
        mc:Ignorable="d"
        Title="Kişisel Günlüğüm"
        Icon="app.ico"
        Height="740"
        Width="1120"
        MinHeight="560"
        MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <local:MoodIconConverter x:Key="MoodIconConverter" />
        <local:ArchiveGroupHeaderConverter x:Key="ArchiveGroupHeaderConverter" />
        <DataTemplate x:Key="ArchiveGroupHeaderTemplate">
            <Grid MinHeight="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="M8,5L15,12L8,19" Fill="Transparent"
                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                            <Setter Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                                             Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Grid.Column="1"
                           Text="{Binding Name, Converter={StaticResource ArchiveGroupHeaderConverter}}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#F1F5F9"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2" Background="#2D325A" CornerRadius="9"
                        MinWidth="24" Padding="6,2" Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ItemCount}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="#A5B4FC"
                               HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>
        <Style x:Key="ArchiveExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}" Padding="0"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                          HorizontalContentAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="9,7">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background"
                                                        Value="{StaticResource BgElevatedBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background"
                                                        Value="#20283A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content"
                                              Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PhotoAspectRatioToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#C7D2FE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="MainWorkspaceGrid">
            <Grid.Effect>
                <BlurEffect x:Name="AuthenticationBlurEffect" Radius="0" />
            </Grid.Effect>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumnDefinition" Width="330" MinWidth="0" MaxWidth="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- SOL KENAR ÇUBUĞU -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18,20,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,16">
                        <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock x:Name="EntryCountText" Text="0 kayıt" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#A5B4FC" />
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="SidebarDiaryTitleText" Text="Kişisel Günlüğüm" FontSize="19"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Düşüncelerini güvenle sakla" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Button x:Name="NewEntryButton" Grid.Row="1" Style="{StaticResource PrimaryButtonStyle}"
                            Click="NewEntryButton_Click" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                  Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Yeni Günlük Ekle" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBoxStyle}"
                                 ToolTip="Metinle ara veya #etiket yaz"
                                 Padding="34,9,12,9" TextChanged="SearchBox_TextChanged" />
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" Width="14" Height="14"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Günlüklerde ara..." Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="36,0,12,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ListBox x:Name="EntriesListBox" Grid.Row="3" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource DiaryListItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="EntriesListBox_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander Style="{StaticResource ArchiveExpanderStyle}"
                                                              Header="{Binding}"
                                                              HeaderTemplate="{StaticResource ArchiveGroupHeaderTemplate}"
                                                              Loaded="ArchiveGroupExpander_Loaded"
                                                              Expanded="ArchiveGroupExpander_Expanded"
                                                              Collapsed="ArchiveGroupExpander_Collapsed"
                                                              Margin="0,3,0,3">
                                                        <ItemsPresenter Margin="12,3,0,0" />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <Border DockPanel.Dock="Right" Background="#242C3F" CornerRadius="7"
                                                Padding="6,3" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Mood, Converter={StaticResource MoodIconConverter}}"
                                                       Width="20" Height="20" Stretch="Uniform" Margin="0,0,5,0"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                <TextBlock Text="{Binding Mood}" FontSize="10.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ShortDateBadge}"
                                                   FontSize="11.5" FontWeight="Medium" Foreground="#A5B4FC"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Path DockPanel.Dock="Left"
                                              Data="M16,3L19,6L15,10L14,15L12,17L10,14L7,11L9,9L14,8Z M11,15L5,21"
                                              Fill="Transparent" Stroke="{StaticResource AccentBrush}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding ContentPreview}" FontSize="12.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" LineHeight="18" />
                                    <TextBlock Text="{Binding TagsDisplay}" FontSize="10.5" Margin="0,5,0,0"
                                               Foreground="#A5B4FC" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyListPlaceholder" Grid.Row="3" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Visibility="Collapsed" Margin="12">
                        <TextBlock Text="Henüz günlük kaydı yok" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Başlamak için yukarıdaki butona tıklayın." FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="4" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                            Padding="0,14,0,0" Margin="0,10,0,0">
                        <StackPanel>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="ExportAllButton_Click"
                                HorizontalContentAlignment="Center" Margin="0,0,0,8"
                                ToolTip="Tüm günlükleri metin dosyasına aktar">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3V15 M7,10L12,15L17,10 M5,19H19"
                                      Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Tüm Günlükleri Dışa Aktar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource SecondaryButtonStyle}"
                                Click="SettingsButton_Click" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                      Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0" />
                                <TextBlock Text="Ayarlar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <!-- SAĞ EDİTÖR ALANI -->
            <Grid Grid.Column="1" Background="{StaticResource BgPrimaryBrush}">
                <StackPanel x:Name="NoSelectionState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource AccentSoftBrush}"
                            Margin="0,0,0,18">
                        <Path Data="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"
                              Fill="#818CF8" Stretch="Uniform" Width="32" Height="32" />
                    </Border>
                    <TextBlock Text="Bir günlük seçin veya yeni bir sayfa açın" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Günlükleriniz şifrelenerek cihazınızda saklanır."
                               FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,22" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="NewEntryButton_Click"
                            HorizontalAlignment="Center" Padding="20,11">
                        <TextBlock Text="İlk Günlüğünü Yaz" />
                    </Button>
                </StackPanel>

                <Grid x:Name="EditorContainerGrid" Visibility="Collapsed" Margin="36,26,36,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="GÜNLÜK BAŞLIĞI" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,8" />
                            <Grid>
                                <TextBox x:Name="EntryTitleTextBox" Style="{StaticResource DarkTextBoxStyle}"
                                         FontSize="22" FontWeight="SemiBold" Padding="12,8"
                                         Background="{StaticResource BgSurfaceBrush}"
                                         BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                         TextChanged="EntryTextChanged" ToolTip="Günlük başlığını yazın" />
                                <TextBlock Text="Başlık girin..." FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="13,8,12,8"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=EntryTitleTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="DeleteEntryButton" Grid.Column="1" Style="{StaticResource DangerButtonStyle}"
                                Click="DeleteEntryButton_Click" VerticalAlignment="Bottom" Margin="16,0,0,2"
                                ToolTip="Seçili günlüğü sil">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,7H20 M10,11V17 M14,11V17 M6,7L7,20H17L18,7 M9,7V4H15V7"
                                      Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0" />
                                <TextBlock Text="Günlüğü Sil" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                Click="ExportSelectedButton_Click" VerticalAlignment="Bottom"
                                Margin="8,0,0,2" ToolTip="Seçili günlüğü metin dosyasına aktar">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3V15 M7,10L12,15L17,10 M5,19H19"
                                      Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0" />
                                <TextBlock Text="Dışa Aktar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="EntryDatePicker" Style="{StaticResource DarkDatePickerStyle}"
                                    SelectedDateChanged="EntryDatePicker_SelectedDateChanged" />
                        <ComboBox x:Name="EntryMoodComboBox" Style="{StaticResource DarkComboBoxStyle}"
                                  Grid.Column="1" Width="145" Margin="10,0,0,0"
                                  VerticalContentAlignment="Center" SelectionChanged="EntryMoodComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BadgeBrush}" CornerRadius="8" Padding="7,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="24" Height="24"
                                                   Stretch="Uniform" Margin="0,0,7,0"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Grid Width="180">
                                <TextBox x:Name="EntryTagsTextBox" Style="{StaticResource DarkTextBoxStyle}"
                                         Padding="10,7" ToolTip="Etiketleri boşlukla ayırarak yazın"
                                         TextChanged="EntryTagsTextBox_TextChanged" />
                                <TextBlock Text="#etiket ekle..." FontSize="13.5"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="11,7,10,7"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=EntryTagsTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="PinEntryButton" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="PinEntryButton_Click" Margin="8,0,0,0" Padding="11,7"
                                    ToolTip="Günlüğü listenin en üstüne sabitle veya sabitlemeyi kaldır">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M16,3L19,6L15,10L14,15L12,17L10,14L7,11L9,9L14,8Z M11,15L5,21"
                                          Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
