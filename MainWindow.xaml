                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ExitButtonBorder" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                        <Setter TargetName="ExitButtonBorder" Property="BorderBrush" Value="{DynamicResource DangerHoverBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ExitButtonBorder" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Uygulamadan çık" FontSize="12.5" FontWeight="Medium" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

