                    Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderFocusBrush}"
                    BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="{DynamicResource AccentColor}" Opacity="0.3" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AuthenticationCardScaleTransform" ScaleX="0.96" ScaleY="0.96" />
                        <TranslateTransform x:Name="AuthenticationCardTranslateTransform" Y="12" />
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,18" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                              Color="{DynamicResource AccentColor}" Opacity="0.28" />
                        </Border.Effect>
                        <Image Source="/app.ico" Width="64" Height="64" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="20" RadiusY="20" />
                            </Image.Clip>
                        </Image>
                    </Border>
