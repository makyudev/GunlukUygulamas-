                               Foreground="{DynamicResource AccentHoverBrush}" Margin="2,0,0,6" Visibility="Collapsed" />
                    <TextBlock x:Name="AuthenticationHintText" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                               Margin="2,0,0,12" Visibility="Collapsed" />
